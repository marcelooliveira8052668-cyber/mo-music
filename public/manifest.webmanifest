{
  "id": "./",
  "name": "M.O Music — Sua música, do seu jeito",
  "short_name": "M.O Music",
  "description": "Plataforma de música completa: suas músicas, playlists, letras e apoio direto ao artista — sem cadastro e funcionando offline.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0a0b10",
  "theme_color": "#0a0b10",
  "categories": ["music", "entertainment"],
  "icons": [
